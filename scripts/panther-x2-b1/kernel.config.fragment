# Panther X2 B1: minimum RAM-only kernel, Linux does not enumerate storage.
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_EXPERT=y

CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y

CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3568=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIOLIB=y
CONFIG_RESET_CONTROLLER=y
CONFIG_ROCKCHIP_GRF=y

# No block-device/storage stack in Linux B1. U-Boot loads the three boot files
# from TF before starting Linux; the kernel and initramfs then run from RAM.
# CONFIG_BLOCK is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NVME_CORE is not set
# CONFIG_MTD is not set

# No network stack, network devices, wireless, Bluetooth, USB or modules.
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_PACKET is not set
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETDEVICES is not set
# CONFIG_ETHERNET is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_DWMAC_ROCKCHIP is not set
# CONFIG_MDIO_BUS is not set
# CONFIG_PHYLIB is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_USB is not set
