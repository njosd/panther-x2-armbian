# Panther X2 B1: normal RK35xx base configuration; isolate network only.
# Seed: Ophub RK35xx 6.12 config; adapted to Linux 6.18.63 by olddefconfig.
# Do not use allnoconfig for the kernel.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_PA_BITS=48
# CONFIG_ARM64_LPA2 is not set
CONFIG_ROCKCHIP_ERRATUM_3568002=y
# CONFIG_NET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_ETHERNET is not set
# CONFIG_PACKET is not set
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_CAN is not set
# CONFIG_PPP is not set
# CONFIG_TUN is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_DWMAC_ROCKCHIP is not set
# CONFIG_MDIO_BUS is not set
# CONFIG_PHYLIB is not set
# CONFIG_REALTEK_PHY is not set
# Wi-Fi/wireless and Bluetooth are permanently excluded from Project A.
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
