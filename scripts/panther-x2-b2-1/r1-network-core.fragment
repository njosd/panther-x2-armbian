# Panther X2 B2-1 R1: minimum generic Ethernet transmit software path.
# Delta is intentionally limited to generic networking core + AF_PACKET.
# No board MAC/MDIO/PHY driver is enabled in R1.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_PACKET=y

# Keep all higher-layer protocols and board Ethernet hardware isolated.
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_STMMAC_PLATFORM is not set
# CONFIG_DWMAC_ROCKCHIP is not set
# CONFIG_MDIO_BUS is not set
# CONFIG_PHYLIB is not set
# CONFIG_REALTEK_PHY is not set

# Project A permanently excludes wireless and Bluetooth.
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set

# Explicitly neutralize network-device options inherited from the broad Ophub seed.
# R1 validates only generic networking/AF_PACKET; no physical NIC, DSA, PHY or offload.
# CONFIG_NET_DSA is not set
# CONFIG_SHORTCUT_FE is not set
# CONFIG_PHYLINK is not set
# CONFIG_PHYLIB is not set
# CONFIG_MDIO is not set
# CONFIG_MDIO_DEVICE is not set
# CONFIG_MDIO_BUS is not set
# CONFIG_MDIO_DEVRES is not set
# CONFIG_NETDEVSIM is not set
# CONFIG_NET_FAILOVER is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_NETPOLL is not set
# CONFIG_NET_POLL_CONTROLLER is not set
# CONFIG_FIXED_PHY is not set
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
# CONFIG_NET_VENDOR_ADI is not set
# CONFIG_NET_VENDOR_AGERE is not set
