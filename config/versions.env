# Panther X2 Armbian research baseline
# Source snapshots and binary release artifacts are tracked separately.
# This is NOT a built or hardware-validated image.

OPHUB_ARMBIAN_REPO=https://github.com/ophub/amlogic-s9xxx-armbian
OPHUB_ARMBIAN_COMMIT=9e71b57f73683f9c4d14a30311e4c2ccbff29566

ARMBIAN_BUILD_REPO=https://github.com/armbian/build
ARMBIAN_BUILD_COMMIT=3f3849bf50bfadff94d0d488eb968bdaf970dc72

# Kernel source reference only. This commit is newer than the 6.18.63
# package asset timestamp; exact source-to-binary provenance is NOT proven.
OPHUB_KERNEL_SOURCE_REPO=https://github.com/ophub/linux-6.18.y
OPHUB_KERNEL_SOURCE_COMMIT=9bbed25243be8b43df410ebb9a8bbb1992234114
KERNEL_SERIES=6.18.y

# Published stable binary package, observed 2026-11-13.
KERNEL_PACKAGE_REPO=https://github.com/ophub/kernel
KERNEL_PACKAGE_RELEASE_TAG=kernel_stable
KERNEL_PACKAGE_VERSION=6.18.63
KERNEL_PACKAGE_ASSET=6.18.63.tar.gz
KERNEL_PACKAGE_SIZE_BYTES=124360986
KERNEL_PACKAGE_SHA256=47e3f46636594cbf212474a13bac97e1310c3ee51007dee3fa20f93d8659f1ca
KERNEL_PACKAGE_URL=https://github.com/ophub/kernel/releases/download/kernel_stable/6.18.63.tar.gz
KERNEL_PACKAGE_VERIFIED_AT=2026-11-13T08:33:29Z
# Digest is GitHub release asset metadata. Verify downloaded bytes again in CI.

OPHUB_UBOOT_REPO=https://github.com/ophub/u-boot
OPHUB_UBOOT_COMMIT=6e70f41585f15c43f45fcae609adec1865e83eb5

OPHUB_FIRMWARE_REPO=https://github.com/ophub/firmware
OPHUB_FIRMWARE_COMMIT=a9d0e8337cc8aa2ca4b482acd7b19c74ce05860f

OPHUB_UPLOAD_ACTION_REPO=https://github.com/ophub/upload-to-releases
OPHUB_UPLOAD_ACTION_COMMIT=af7efd63a4b5e5edd715b304ebdbe0572fa06619

ACTIONS_CHECKOUT_COMMIT=11bd71901bbe5b1630ceea73d27597364c9af683
ACTIONS_UPLOAD_ARTIFACT_COMMIT=ea165f8d65b6e75b540449e92b4886f43607fa02

TARGET_BOARD=panther-x2
TARGET_DTB=rk3566-panther-x2.dtb
TARGET_KERNEL_BRANCH=stable
TARGET_ROOTFS=noble
TARGET_FILESYSTEM=ext4
TARGET_EDITION=server
TARGET_ARCH=arm64

# First boot / test medium
BOOT_MEDIUM=independent-tf-card
INSTALL_TO_EMMC=false

# Fixed audit input for the RK3566 out-of-tree RKNPU module.
RKNPU_MODULE_REPO=https://github.com/w568w/rknpu-module
RKNPU_MODULE_COMMIT=a8792fe6b633f90cf2c6808267cac327537ab4cf
RKNPU_MODULE_VERSION=0.9.8
